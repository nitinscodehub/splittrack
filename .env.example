# ---------------------------------------------------------------------------
# Database (Neon / Supabase / any PostgreSQL)
# DATABASE_URL  -> pooled connection used by the app at runtime.
# DIRECT_URL    -> direct (non-pooled) connection used by Prisma migrations.
# npm run setup derives DIRECT_URL automatically from a Neon pooled URL.
# Locally both can be the same PostgreSQL URL.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/splittrack?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/splittrack?schema=public"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth
# npm run setup generates a strong secret automatically.
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Public app URL (used in emails, invite links, UPI and metadata)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Gmail SMTP (Nodemailer)
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create an App Password (Google Account -> Security -> App passwords).
# 3. Paste the 16-character password below.
# npm run setup asks for these three values only.
# ---------------------------------------------------------------------------
SMTP_USER="your.email@gmail.com"
SMTP_APP_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM="SplitTrack <your.email@gmail.com>"

# Local test mode: true = skip Gmail and show OTP on the verify screen.
# It is automatically ignored in production builds, so it can never expose OTPs
# on a deployed Vercel app. Set false when you want real email locally too.
DEV_OTP_MODE="false"

# ---------------------------------------------------------------------------
# Profile photo storage (optional, Neon Object Storage)
# Neon injects these automatically when an Object Storage bucket is configured.
# Without them the app still works; photo upload stays disabled with a clear
# error. The app uses the "uploads" bucket by default.
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_ENDPOINT_URL_S3=""
# AWS_REGION=""

# ---------------------------------------------------------------------------
# Daily reminder cron protection. Vercel sends: Authorization: Bearer <secret>
# npm run setup generates this automatically.
# ---------------------------------------------------------------------------
CRON_SECRET="replace-with-openssl-rand-hex-32"
